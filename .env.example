# ==============================================================================
# MOIL Space-Reserve Intelligence Platform - Environment Configuration
# ==============================================================================

# Mapbox Public Access Token (Optional: falls back to free Esri World Imagery if left blank)
# Get a free token at https://account.mapbox.com
VITE_MAPBOX_TOKEN=

# Copernicus Data Space / Sentinel Hub OAuth Credentials (Optional for live satellite WMS)
# Get credentials at https://dataspace.copernicus.eu
VITE_SENTINEL_HUB_CLIENT_ID=
VITE_SENTINEL_HUB_CLIENT_SECRET=

# OpenWeather / IMD Precipitation API Key (Optional)
VITE_OPENWEATHER_API_KEY=
